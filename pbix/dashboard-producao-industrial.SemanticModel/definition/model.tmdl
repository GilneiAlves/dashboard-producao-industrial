model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["dCalendario","dSetores","fProducaoIndustrial","Caminho_Arquivos","Metricas","Segmentacao"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table dCalendario
ref table dSetores
ref table fProducaoIndustrial
ref table Metricas
ref table Tabela_aux
ref table Segmentacao

ref cultureInfo pt-BR

